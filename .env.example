# .env.example: the environment variables Cardio Explorer's pipeline knows about.
# Copy to .env only for local experiments; .env is git-ignored. NEVER put real secrets in
# this file or in any committed file.
#
# Where the real values live:
#   - GitHub > Settings > Environments (development / staging / production):
#       variables APP_ENV, APP_URL (+ optional GOOGLE_CLIENT_ID, TURNSTILE_SITE_KEY,
#       POSTHOG_KEY, POSTHOG_HOST) and the five secrets below.
#   - GitHub > Settings > Secrets and variables > Actions (repository secrets):
#       NETLIFY_AUTH_TOKEN and NETLIFY_SITE_ID. Not listed here on purpose: the Netlify
#       token is only ever pasted into GitHub, never into a file.
#
# The app is a static, client-only site today: it has no database, logins, CAPTCHA or
# payments, so the five secrets are placeholders ("not-set-yet") for future weeks.

# --- Server-side variables (Netlify Functions; never shipped to the browser) ---
APP_ENV=development
APP_URL=http://localhost:5173
GOOGLE_CLIENT_ID=

# --- Server-side secrets (placeholders until a feature needs them) ---
DATABASE_URL=not-set-yet
SESSION_SECRET=not-set-yet
TURNSTILE_SECRET_KEY=not-set-yet
STRIPE_SECRET_KEY=not-set-yet
STRIPE_WEBHOOK_SECRET=not-set-yet

# --- Browser variables (Vite) ---
# Anything starting with VITE_ is compiled INTO the public JavaScript bundle and is
# visible to every visitor. Only ever put public, non-secret values here.
VITE_APP_ENV=development
VITE_GOOGLE_CLIENT_ID=
VITE_TURNSTILE_SITE_KEY=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
